# Copy to .env.local (git-ignored) or set in the Vercel project settings.
# Base URL of the backend API, no trailing slash. Read at build time.
# Leave unset locally: the default '/api' goes through the Vite dev proxy.
# The backend must allow this frontend's origin in CE_ALLOWED_ORIGINS.
VITE_API_URL=https://your-backend.onrender.com
