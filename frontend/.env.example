# Copy to .env.local (git-ignored) or set in the Vercel project settings.
# Base URL of the backend API, no trailing slash. Read at build time; `npm run build` fails without it.
# The browser calls this URL directly (also the event stream), so the backend must allow
# this frontend's origin in CE_ALLOWED_ORIGINS.
# Leave unset for `npm run dev`: the dev server proxies '/api' to a local backend.
VITE_API_URL=https://your-backend.onrender.com
